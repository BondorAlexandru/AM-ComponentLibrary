{
  "name": "@am/ui",
  "version": "0.2.0",
  "description": "AM shared design system \u2014 token-driven React primitives for the CMS (SpaceBlock) and AM Campaigns apps.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BondorAlexandru/AM-ComponentLibrary.git"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/contract.d.ts",
      "default": "./dist/tokens/contract.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:test": "npm --prefix site run test",
    "site:typecheck": "npm --prefix site run typecheck",
    "check:themes": "node scripts/check-theme-drift.mjs",
    "verify:dist": "npm run build && git diff --exit-code --stat -- dist || (echo '\\ndist/ is stale \u2014 run `npm run build` and commit dist/.' && exit 1)",
    "check": "npm run typecheck && npm test && npm run build && npm run site:typecheck && npm run site:test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
